{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "/**"
        }
      ]
    },
    "shell:default",
    "shell:allow-kill",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/rg",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/fd",
          "sidecar": true,
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/rg",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/fd",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "dialog:default"
  ]
}